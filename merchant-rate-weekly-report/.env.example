# merchant-rate-weekly-report — copy to .env and fill in (see README.md).
# The merchant-rate-auditor code is bundled in ./merchant-rate-auditor/; one `npm install` at this folder root is enough.

# Google Sheets (required for “Sync to Google Sheet”)
# 1) Create a Google Cloud project → APIs & Services → Enable “Google Sheets API”
# 2) Create a Service Account → JSON key → save as ./secrets/google-sheets-key.json (or set path below)
# 3) Share your spreadsheet with the service account email (Editor)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-sheets-key.json

# Your spreadsheet (defaults match the sheet you linked)
SPREADSHEET_ID=194oJaxgMLAfoFvPgbqVOfTZnU3mVBSqT-hl8EIOnNQE
# Where to write each audit:
#   new (default) = create a NEW tab every run (name like "Rate audit 2026-04-22 143052")
#   fixed         = append rows to one existing tab (set SHEET_GID or SHEET_TAB_NAME)
SHEET_APPEND_MODE=new

# Only used when SHEET_APPEND_MODE=fixed — tab gid from URL
# SHEET_GID=1072101362
# Or set the exact tab name:
# SHEET_TAB_NAME=Sheet1

# Weekly schedule: Monday at 08:00 (24h) in this timezone
WEEKLY_CRON_HOUR=8
WEEKLY_CRON_MINUTE=0
TZ=America/New_York

# Port for the web UI
PORT=3847

# Set to 1 to run only the UI + manual runs (no Monday cron)
# DISABLE_WEEKLY_CRON=1

# Optional: date column on commission_detail_view_2 for a 6‑month filter (COMMISSION_LOOKBACK_MONTHS in code, default 6).
# Leave unset for no date filter (all‑time sum per merchant). Use none/off to force no filter if set elsewhere.
# COMMISSION_DATE_COLUMN=event_date

# BigQuery job project (defaults to wildfire-1000). Your GOOGLE_APPLICATION_CREDENTIALS
# service account must have roles/bigquery.jobUser on this project, plus data access to the commission + merchant tables.
# BIGQUERY_PROJECT_ID=wildfire-1000

# Commissions (BigQuery / ADC / CSV fallback — see README):
# - Use a different JSON key only for BigQuery (path relative to this folder is ok). If set, this wins over COMMISSION_USE_ADC.
# BIGQUERY_APPLICATION_CREDENTIALS=./secrets/bigquery-sa.json
# - Or use application-default credentials (your user after `gcloud auth application-default login`). While the
#   commission query runs, GOOGLE_APPLICATION_CREDENTIALS is temporarily unset so the library does not use the Sheets SA for BQ.
# COMMISSION_USE_ADC=1
# - Or load from an exported CSV (merchant_id + commission column) if BigQuery is unavailable:
# COMMISSION_CSV_PATH=./data/commissions-export.csv
