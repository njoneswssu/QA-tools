    ];
    
    // Fisher-Yates shuffle algorithm to randomize website order
    function shuffleArray(array) {
      const shuffled = [...array]; // Create a copy to avoid mutating original
      for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }
    
    // Randomize the website order for this test run
    const randomizedWebsites = shuffleArray(websites);
    
         console.log(`🚀 CitiShop multi-website test - ${randomizedWebsites.length} websites (randomized order)\n`);
         console.log(`🔀 Today's random order:`);
         randomizedWebsites.forEach((site, index) => {
           console.log(`   ${index + 1}. ${site.name}`);
         });
         console.log('');
         console.log(`⏹️  Press CTRL+C to stop the test early (or close terminal)\n`);
    
    // Variable to track if user wants to stop the test
    let shouldStopTest = false;
    let completedWebsites = 0;
    
    // Add global process listener for CTRL+C with graceful handling
    const stopHandler = () => {
      if (shouldStopTest) {
        // If already stopping, force exit
        console.log(`\n🚨 Force exit requested - stopping immediately...`);
        process.exit(0);
      } else {
        // First CTRL+C - set graceful stop
        console.log(`\n🛑 CTRL+C detected - will stop gracefully after current website...`);
        console.log(`⏳ Press CTRL+C again to force immediate exit`);
        shouldStopTest = true;
      }
    };
    
    process.on('SIGINT', stopHandler);
    
    // Visit each website in a new tab
    for (let i = 0; i < randomizedWebsites.length; i++) {
      
      // Check if user requested to stop
      if (shouldStopTest) {
        console.log(`\n🛑 Test stopped by user request`);
        console.log(`📊 Completed ${i}/${randomizedWebsites.length} websites before stopping`);
        break;
      }
      const website = randomizedWebsites[i];
      const currentSite = i + 1;
      
      console.log(`\n${'='.repeat(50)}`);
      console.log(`🌐 WEBSITE ${currentSite}/${randomizedWebsites.length}: ${website.name}`);
      console.log(`🔗 ${website.url}`);
      console.log(`${'='.repeat(50)}\n`);
      
      // Create a new tab for each website
      console.log(`🆕 Opening new tab for ${website.name}...`);
      const page = await context.newPage();
      
      // Handle uncaught exceptions for this page
      page.on('pageerror', (error) => {
        console.log('Page error:', error.message);
        // Don't fail the test on page errors
      });
      
      // No need for individual page keyboard listeners - using CTRL+C instead
      
      try {
        // Navigate to website
        console.log(`🚀 Navigating to ${website.name}...`);
        await page.goto(website.url, { waitUntil: 'domcontentloaded' });
        
        // Wait for initial page load (fast)
        console.log(`⏳ Waiting for ${website.name} initial load...`);
        await page.waitForLoadState('domcontentloaded');
        await page.waitForTimeout(1000);
        
        console.log(`✅ ${website.name} initial load completed!`);
        console.log(`📋 Website ${currentSite}/${randomizedWebsites.length}: ${website.name}`);
        
        // Wait for user to close the page/tab before continuing to next website
        console.log(`\n⏸️  WAITING FOR PAGE TO BE CLOSED...`);
        console.log(`🔄 Please close this website tab/page when you're done`);
        console.log(`⏭️  The script will automatically continue to the next website once this page is closed`);
        console.log(`🛑 Press CTRL+C to stop the test early`);
        
        if (currentSite < randomizedWebsites.length) {
          console.log(`📋 Next website: ${randomizedWebsites[currentSite].name}`);
        } else {
          console.log(`🏁 This is the LAST website!`);
        }
        
        // Wait for page to be closed before moving to next website
        await waitForPageClosed(page, website.name);
        
        console.log(`✅ ${website.name} page closed - testing completed!`);
        completedWebsites++;
        
        // Check again if user requested to stop after page close
        if (shouldStopTest) {
          console.log(`🛑 Stop requested - ending test after ${website.name}`);
          break;
        }
        
        // Small delay before moving to next website
        console.log(`⏳ Preparing for next website...`);
        await new Promise(resolve => setTimeout(resolve, 2000));
        console.log(``);
        
      } catch (error) {
        console.log(`❌ Error testing ${website.name}: ${error.message}`);
        console.log(`⚠️ Continuing to next website automatically...\n`);
        
        // Quick delay for error visibility  
        await new Promise(resolve => setTimeout(resolve, 1000));
      }
    }
    
         // Final summary
     console.log(`\n${'='.repeat(60)}`);
     if (shouldStopTest) {
       console.log(`🛑 CITISHOP TEST STOPPED EARLY`);
       console.log(`📊 Websites tested before stopping:`);
       for (let j = 0; j < completedWebsites && j < randomizedWebsites.length; j++) {
         console.log(`   ${j + 1}. ${randomizedWebsites[j].name} ✅`);
       }
       console.log(`📋 Remaining websites skipped: ${randomizedWebsites.length - completedWebsites}`);
     } else {
       console.log(`🎉 CITISHOP MULTI-WEBSITE TEST COMPLETED!`);
       console.log(`📊 All ${randomizedWebsites.length} websites tested:`);
       randomizedWebsites.forEach((site, index) => {
         console.log(`   ${index + 1}. ${site.name} ✅`);
       });
       console.log(`✅ All websites processed successfully!`);
     }
     console.log(`${'='.repeat(60)}\n`);
     
     if (shouldStopTest) {
       console.log(`🛑 CitiShop test stopped by user request`);
       console.log(`📊 Total processed: ${completedWebsites}/${randomizedWebsites.length} websites`);
     } else {
       console.log(`✅ CitiShop multi-website test completed!`);
       console.log(`🚀 All websites processed automatically!`);
     }
     console.log(`ℹ️ Browser will remain open for review...`);
     
     // Remove the SIGINT listener
     process.off('SIGINT', stopHandler);
     
     // Small delay before finishing
     await new Promise(resolve => setTimeout(resolve, 3000));
     
     // Keep browser open
     // await context.close();
  });
});