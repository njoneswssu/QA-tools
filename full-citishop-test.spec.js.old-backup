const { test, expect, chromium } = require('@playwright/test');
const path = require('path');
const fs = require('fs');

// Simplified helper function to wait for page to be closed
async function waitForPageClosed(page, websiteName) {
  return new Promise((resolve) => {
    console.log(`⏳ Waiting for ${websiteName} page to be closed...`);
    
    // Simple polling approach - check every second if page is still accessible
    const pollInterval = setInterval(() => {
      try {
        // Try to access page URL - if this throws, page is closed
        page.url();
      } catch (e) {
        // Page is closed or inaccessible
        console.log(`✅ Page closed for ${websiteName} - continuing to next website...`);
        clearInterval(pollInterval);
        resolve();
      }
    }, 1000);
    
    // Also listen for the close event as backup
    const closeHandler = () => {
      console.log(`🚪 Page close event detected for ${websiteName}`);
      clearInterval(pollInterval);
      resolve();
    };
    
    try {
      page.on('close', closeHandler);
    } catch (e) {
      // Page might already be closed
      console.log(`✅ Page already closed for ${websiteName}`);
      clearInterval(pollInterval);
      resolve();
    }
  });
}

test.describe('CitiShop Multi-Website Test', () => {
  test('Test CitiShop extension on all websites', async () => {
    // Extended timeout for all websites
    test.setTimeout(600000); // 10 minutes
    
    // Launch browser with CitiShop extension
    const pathToExtension = path.join('/Users/neil/Documents/CitiBuild 1.14');
    const userDataDir = path.join(__dirname, '..', 'browser-data', 'citishop-profile');
    
    console.log(`🔧 Extension path: ${pathToExtension}`);
    console.log(`🔧 User data dir: ${userDataDir}`);
    
    // Check if extension path exists
    if (!fs.existsSync(pathToExtension)) {
      console.log('❌ Extension path does not exist!');
      throw new Error(`Extension path not found: ${pathToExtension}`);
    }
    
    const context = await chromium.launchPersistentContext(userDataDir, {
      headless: false, // Extensions require headed mode
      args: [
        `--disable-extensions-except=${pathToExtension}`,
        `--load-extension=${pathToExtension}`,
        '--no-first-run',
        '--disable-blink-features=AutomationControlled',
        '--disable-web-security',
        '--disable-features=VizDisplayCompositor',
        '--disable-popup-blocking',
        '--disable-notifications',
        '--enable-extensions',
        '--disable-extensions-file-access-check',
        '--allow-running-insecure-content',
        '--disable-backgrounding-occluded-windows',
        '--disable-background-timer-throttling',
        '--disable-renderer-backgrounding',
        '--disable-features=TranslateUI',
        '--disable-ipc-flooding-protection'
      ],
      viewport: { width: 1200, height: 1200 },
