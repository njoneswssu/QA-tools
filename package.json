{
  "name": "merchant-test-dashboard",
  "version": "1.0.0",
  "description": "Dashboard for viewing merchant website test results",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node database/init_db.js",
    "populate-merchants": "node database/populate_merchants.js",
    "setup": "npm install && npm run init-db && npm run populate-merchants"
  },
  "keywords": [
    "merchant",
    "testing",
    "dashboard",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}