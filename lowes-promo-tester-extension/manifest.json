{
  "manifest_version": 3,
  "name": "Lowe's Promo Tester",
  "version": "1.0.0",
  "description": "Promo testing for Lowe's blind configurators — same flow as lowes-promo-tester (dimensions, color, prices, screenshot).",
  "permissions": ["storage", "scripting", "tabs", "windows", "sidePanel", "activeTab"],
  "host_permissions": ["https://www.lowes.com/*", "https://lowes.com/*", "https://*.lowes.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Lowe's Promo Tester"
  },
  "content_scripts": [
    {
      "matches": ["https://www.lowes.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
