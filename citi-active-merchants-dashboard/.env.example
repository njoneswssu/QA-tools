PORT=3950
TZ=America/New_York
# Weekly job: minute hour day-of-month month day-of-week (Monday = 1)
WEEKLY_CRON_MINUTE=5
WEEKLY_CRON_HOUR=7
DISABLE_WEEKLY_CRON=0
# Optional: require this header for POST /api/run — x-api-key: <value>
RUN_API_KEY=

# Team URL + shared history: set on your host (e.g. Neon + Render). Omit for local ./data only.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=false
# Optional: where to write JSON files when not using DATABASE_URL
# DATA_DIR=./data

# --- Docker Compose (team server) — copy this file to .env next to docker-compose.yml
# POSTGRES_USER=citi
# POSTGRES_PASSWORD=use-a-long-random-secret-in-production
# POSTGRES_DB=citi
# DASHBOARD_PORT=3950
# RUN_API_KEY=optional-long-secret-for-run-sync-button
