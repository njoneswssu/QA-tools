{
  "name": "api-merchant-tester",
  "version": "1.0.0",
  "description": "Standalone API-driven merchant website tester with Playwright automation",
  "main": "tester-server.js",
  "scripts": {
    "start": "node tester-server.js",
    "dev": "nodemon tester-server.js",
    "test": "npx playwright test api-merchant-tester.spec.js --headed",
    "test-headless": "npx playwright test api-merchant-tester.spec.js",
    "init-db": "node database/init_db.js",
    "populate-merchants": "node database/populate_merchants.js",
    "setup": "npm install && npx playwright install && npm run init-db",
    "install-browsers": "npx playwright install"
  },
  "keywords": [
    "playwright",
    "automation",
    "merchant",
    "testing",
    "api",
    "e-commerce"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "@playwright/test": "^1.40.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
